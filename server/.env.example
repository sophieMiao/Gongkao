# Server environment variables
# Copy this file to .env and fill in the values

# Server
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Database
DATABASE_URL="file:./data/gongkao.db"
# For PostgreSQL: "postgresql://user:password@localhost:5432/gongkao"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Feishu OAuth (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760 # 10MB

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# WebSocket
WS_PATH=/ws

# Email (optional for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
