# StepFun API Key for AI question generation
STEPFUN_API_KEY=your_stepfun_api_key_here

# Feishu (Lark) App Credentials
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# Feishu Bitable (Multidimensional Table) Configuration
BITABLE_APP_TOKEN=your_bitable_app_token
USERS_TABLE_ID=your_users_table_id
TASKS_TABLE_ID=your_tasks_table_id
PROGRESS_TABLE_ID=your_progress_table_id
KNOWLEDGE_TABLE_ID=your_knowledge_table_id

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://localhost:8080

# Agent Configuration
AGENT_NAME=考公学习伴侣
TIMEZONE=Asia/Shanghai

# Notification Settings
DAILY_TASK_TIME=08:00
WEEKLY_REPORT_DAY=Monday
WEEKLY_REPORT_TIME=09:00

# AI Generator Settings
AI_GENERATOR_ENABLED=true
MAX_GENERATE_PER_DAY=20

# Database (if using SQLite instead of Feishu)
# DATABASE_URL=sqlite:///data/cangkou.db
