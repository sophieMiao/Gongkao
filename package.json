{
  "name": "kaogong-agent",
  "version": "2.0.0-saas",
  "scripts": {
    "start": "node server.saas.js",
    "dev": "nodemon server.saas.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "setup": "python scripts/init_db.py",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "docker:build": "docker build -f Dockerfile.saas -t kaogong-agent .",
    "docker:run": "docker-compose -f docker-compose.saas.yml up -d"
  },
  "dependencies": {
    "express": "^4.18.2",
    "prisma": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "node-cron": "^3.0.2",
    "node-fetch": "^3.3.2",
    "jsonwebtoken": "^9.0.2",
    "crypto": "^1.0.1",
    "openclaw": "^1.0.0",
    "qdrant": "^1.7.0",
    "natural": "^6.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0"
  }
}
