{
  "name": "kaogong-agent",
  "version": "2.0.0-saas",
  "description": "考公学习伴侣 - SaaS托管服务版，像多邻国一样的AI公务员考试备考助手",
  "main": "server.saas.js",
  "scripts": {
    "start": "node server.saas.js",
    "dev": "nodemon server.saas.js",
    "setup": "python scripts/init_db.py",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "test": "pytest tests/",
    "test:unit": "pytest tests/unit/",
    "test:integration": "pytest tests/integration/",
    "lint": "eslint . --ext .js",
    "docker:build": "docker build -f Dockerfile.saas -t kaogong-agent .",
    "docker:run": "docker-compose -f docker-compose.saas.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.saas.yml down"
  },
  "keywords": [
    "openclaw",
    "agent",
    "civil-service-exam",
    "education",
    "ai",
    "learning-assistant",
    "saas"
  ],
  "author": "Sophie Miao",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "prisma": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "node-cron": "^3.0.2",
    "node-fetch": "^3.3.2",
    "jsonwebtoken": "^9.0.2",
    "crypto": "^1.0.1",
    "openclaw": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "eslint": "^8.0.0",
    "pytest": "^7.0.0",
    "prisma-erd-generator": "^1.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "prom-client": "^14.2.0"
  },
  "scripts": {
    "start": "node server.saas.js",
    "dev": "nodemon server.saas.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "setup": "python scripts/init_db.py",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "test": "pytest tests/",
    "test:unit": "pytest tests/unit/",
    "test:integration": "pytest tests/integration/",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "docker:build": "docker build -f Dockerfile.saas -t kaogong-agent .",
    "docker:run": "docker-compose -f docker-compose.saas.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.saas.yml down",
    "metrics": "node -e \"require('./utils/metrics').startSystemMetricsUpdater()\""
  },,
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sophieMiao/Gongkao.git"
  },
  "bugs": {
    "url": "https://github.com/sophieMiao/Gongkao/issues"
  },
  "homepage": "https://github.com/sophieMiao/Gongkao#readme"
}
