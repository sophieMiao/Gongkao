# 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== 服务端配置 ====================
NODE_ENV=production
PORT=8080
JWT_SECRET=your_jwt_secret_key_here_change_this
DATABASE_URL=postgresql://kaogong:your_password@postgres:5432/kaogong

# ==================== 飞书配置（统一应用） ====================
# 只需申请一个飞书应用，所有用户共享
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_BOT_TOKEN=your_bot_token
FEISHU_VERIFICATION_TOKEN=your_verification_token

# 机器人名称（显示在飞书里）
BOT_NAME=考公学习伴侣

# ==================== StepFun AI ====================
STEPFUN_API_KEY=your_stepfun_api_key

# ==================== 定时任务配置 ====================
# 每日任务推送时间（24小时制，Asia/Shanghai）
DAILY_TASK_TIME=08:00

# 周报推送时间
WEEKLY_REPORT_DAY=Monday
WEEKLY_REPORT_TIME=09:00

# ==================== 管理后台（可选） ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# ==================== 成本控制（可选） ====================
# 每日每用户最多AI生成题目数（防止滥用）
MAX_AI_QUESTIONS_PER_USER_PER_DAY=10

# 免费用户每日任务上限（如为付费服务可去掉）
FREE_DAILY_TASK_LIMIT=10
