    "bcryptjs": "^2.4.3",
    "prisma": "^5.0.0",
    "@prisma/client": "^5.0.0",
    "better-sqlite3": "^9.2.2",
    "node-cron": "^3.0.2",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^6.10.0",
    "express-slow-down": "^2.0.1",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "eslint": "^8.0.0",
